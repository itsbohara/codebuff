# Docker-specific environment variables
# Copy this file to .env.local when running with Docker, or use:
#   docker compose --env-file .env.docker up
#
# This file uses host.docker.internal to allow the container to reach
# PostgreSQL running on the host machine.

# AI API Keys - Only OpenRouter is required
OPEN_ROUTER_API_KEY=your_openrouter_key_here
# Optional: Custom OpenAI-compatible endpoint (defaults to OpenRouter)
# Can be used with LiteLLM proxy, local LLMs (Ollama, vLLM), or other providers
OPENROUTER_BASE_URL=http://localhost:6767/

# Optional: Direct provider keys (not needed if using OpenRouter)
CLAUDE_CODE_KEY=dummy_claude_code_key
OPEN_ROUTER_API_KEY=dummy_openrouter_key
OPENAI_API_KEY=dummy_openai_key
ANTHROPIC_API_KEY=dummy_anthropic_key
FIREWORKS_API_KEY=dummy_fireworks_key

# LLM model for complex tasks (orchestrator, code review, multi-prompt editing)
CODEBUFF_MAX_MODE_MODEL=openrouter/claude-opus-4.5

# LLM model for lightweight tasks (file search, terminal commands) - falls back to CODEBUFF_MAX_MODE_MODEL if not set
CODEBUFF_MAX_MODE_HELPER_MODEL=openrouter/kimi-k2.5

# LLM model for research tasks (web search, docs) - falls back to CODEBUFF_MAX_MODE_HELPER_MODEL if not set
CODEBUFF_MAX_MODE_RESEARCHER_MODEL=openrouter/kimi-k2.5

# Database & Server
DATABASE_URL=postgresql://manicode_user_local:secretpassword_local@localhost:5432/manicode_db_local
PORT=4242

# Authentication
CODEBUFF_GITHUB_ID=dummy_github_id
CODEBUFF_GITHUB_SECRET=dummy_github_secret
NEXTAUTH_SECRET=dummy_nextauth_secret_at_least_32_chars_long

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_dummy_stripe_secret
STRIPE_WEBHOOK_SECRET_KEY=whsec_dummy_webhook_secret
STRIPE_TEAM_FEE_PRICE_ID=price_dummy_team_fee_id
STRIPE_SUBSCRIPTION_100_PRICE_ID=price_dummy_subscription_100_id
STRIPE_SUBSCRIPTION_200_PRICE_ID=price_dummy_subscription_200_id
STRIPE_SUBSCRIPTION_500_PRICE_ID=price_dummy_subscription_500_id

# External Services
# Web Search Provider: 'linkup' (requires LINKUP_API_KEY) or 'exa' (optional EXA_API_KEY for higher limits)
WEB_SEARCH_PROVIDER=exa
LINKUP_API_KEY=dummy_linkup_key
# EXA_API_KEY is optional - EXA provides basic functionality without an API key
# EXA_API_KEY=your_exa_key_here
LOOPS_API_KEY=dummy_loops_key

# Discord Integration
DISCORD_PUBLIC_KEY=dummy_discord_public_key
DISCORD_BOT_TOKEN=dummy_discord_bot_token
DISCORD_APPLICATION_ID=dummy_discord_app_id

# Frontend/Public Variables
NEXT_PUBLIC_CB_ENVIRONMENT=dev
NEXT_PUBLIC_CODEBUFF_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@codebuff.com
NEXT_PUBLIC_POSTHOG_API_KEY=phc_dummy_posthog_key
NEXT_PUBLIC_POSTHOG_HOST_URL=https://us.i.posthog.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy_publishable
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL=https://billing.stripe.com/p/login/test_dummy
NEXT_PUBLIC_WEB_PORT=3000
